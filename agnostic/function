function ggrep
{
  local usage="Usage: genericgrep separator string filename"
  local separator=$1
  local string=$2
  local filename=$3

  if [ x$3 == x ]; then
    echo $usage;
    return 0;
  fi

  perl -e"
  $/ = '$separator';
  open IN, shift;
  while ( <IN> ) { if ( m/$string/i ) { print; print \"\n--------------------------------------------\n\" } }" $filename
  echo
}

function ggrepv
# like grep -v
{
  local separator=$1
  local string=$2
  local filename=$3

  perl -e"
  $/ = '$separator';
  open IN, shift;
  while ( <IN> ) { unless ( m/$string/i ) { print; print \"\n--------------------------------------------\n\" } }" $filename
  echo
}


