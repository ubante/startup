function gitclone {
  # The new structure will be:
  # ~/src/VCS-universe/org/repo
  # eg:
  # /Users/j.ubante/src/github.com/GoogleCloudPlatform/terraformer

  srcDir=~/src
  repository=$1

  if [ -z $repository ] ; then
    echo "Usage: gitclone reponame"
    echo
    echo "This will create a dir tree in ${srcDir}."
    echo
    echo "Example: gitclone git@github.com:GoogleCloudPlatform/terraformer.git"
    return 1
  fi

  vcsDir=`echo $repository | cut -f1 -d\: | cut -f2 -d@`
  orgDir=`echo $repository | cut -f2 -d\: | cut -f1 -d\/`
  repoDir=`echo $repository | cut -f2 -d\/ | cut -f1 -d\.`

  vcsPath=$srcDir/$vcsDir
  orgPath=$vcsPath/$orgDir
  repoPath=$orgPath/$repoDir
  
  if [ -e $repoPath ]; then
    echo "This already exists: $repoPath"
    if ( _yes_no "$repoDir repo already exists.  Archive? [y/n] "); then
      echo "Archiving to $GRITYARD..."

	  # This could go into a new function, grityardcore, and be reused by the griyard function.
      getLastChar $repoPath
      now=`_getDetailedDate2`;
      destdir=$GRITYARD/${repoDir}_$now;
	  echo Moving $repoPath to $destdir
      mv $repoPath $destdir || (echo fatal problems && return)

      echo "Re-cloning..."
    else
      ls -ld $repoPath
      cd $repoPath
      echo Local:
      git --no-pager branch
      echo Remote:
      git --no-pager branch -r
      echo
      git status
      echo
      echo Be sure to git pull....

      return 1
    fi
  fi

  for aPath in $vcsPath $orgPath; do
    if [ ! -e $aPath ]; then
      echo "Creating $aPath"
      mkdir $aPath
    fi
  done

  #echo $repoPath && return
 
  cd $orgPath
  echo "Trying to clone ${repository}...."
  git clone ${repository} || return 1
  cd $repoDir
  echo
  pwd
  echo
  echo Remote:
  git --no-pager branch -r
  echo Local:
  git --no-pager branch
  pwd
}

