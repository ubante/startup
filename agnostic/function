function nslookuprange
{
  local usage="Usage: nslookuprange subnet startnumber endnumber"
  local subnet=$1
  local startnumber=$2
  local endnumber=$3

  if [ x$3 == x ]; then
    echo $usage;
    return 0;
  fi

  echo "looping from $subnet.$startnumber to $subnet.$endnumber"
  echo
  for i in `count $startnumber $endnumber`;
  do
        ip=$subnet.$i
        name=`nslookup $ip 2>/dev/null | grep name | awk ' { print $4 } '`
        if [ x$name != x ]; then
          echo "$ip   $name"
        fi
  done

}

function dns2table
{
  local usage="Usage: $0 subnet startnumber endnumber"
  local subnet=$1
  local startnumber=$2
  local endnumber=$3

  nslookuprange $1 $2 $3 | tail +3 | cut -f1-4 -d\. | awk ' { print " | " $2 " | " $1 " | "} '
}

function findcores
{   
    HERE=$PWD
    cd $HOME/.startup
    CORES=`find . -type f -name \*core`
    FIRSTCORE=`echo $CORES | cut -f1 -d\ `
    if [ x$FIRSTCORE != "x" ]; then
	echo
	for singlecore in $CORES; do echo $singlecore; done
	echo
        if ( _yes_no "Found cores:  delete them? " ); then
            rm $CORES
            echo "cores deleted"
        else
            echo "cores ignored"
        fi
    fi
    cd $HERE 
