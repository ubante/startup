function unknow {
  cp ~/.ssh/known_hosts ~/.ssh/known_hosts-original
  ssh-keygen -R $1 -f ~/.ssh/known_hosts
  echo
  echo "The diff:"
  diff ~/.ssh/known_hosts ~/.ssh/known_hosts-original
}

