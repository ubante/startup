  gitBranch=`git --no-pager branch | grep \* | awk ' { print $2 } '` 
  gitPath=`git-absolute-path`
  gitUrl="https://github.com/${gitOrg}/${gitRepo}/blob/${gitBranch}/${gitPath}${filename}"

  echo
  echo $gitUrl
  echo

  open $gitUrl
}

