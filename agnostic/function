}

function gfogrom {
    primary_branch_name=`git branch -r | grep origin/HEAD | awk ' { print $3 } ' | cut -f2 -d\/`
    # it's possible that there is no origin/HEAD because the local repo
    # was `git remote add`d, eg this repo was once.  Assume "main" for now.
    if [ -z "$primary_branch_name" ]; then
      echo "could not determine origin/HEAD; using main";
      primary_branch_name=main;
    fi
    echo "primary branch ==> $primary_branch_name"
    echo git fetch origin --prune....;
    git fetch origin --prune;
    echo;
    echo switching to $primary_branch_name....;
    git checkout $primary_branch_name;
    echo git rebase origin/$primary_branch_name....;
    git rebase origin/$primary_branch_name;
    echo switching back....;
    git checkout -;
    echo
}

