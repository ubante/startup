function itogrep
{ 
    local usage="Usage: itogrep string path_to_log"
    if [ x$1 == x ]; then
        echo $usage;
        return 0;
    fi
    if [ x$2 == x ]; then
        echo $usage;
        return 0;
    fi
    perl -e"
    $/ = '<<<<<';
    open IN, shift;
    while ( <IN> ) { if ( m/$1/i ) { print } }" $2
    echo
}

