function grepApacheConf
{
  local HERE=`pwd`
  cd ~/tmp
  ps -ef | grep http | grep root | cut -f2 -d\? | awk ' { print $2 } ' > apaches$$
  for i in `cat apaches$$`
  do
    BASE1=`dirname $i`
    BASE2=`dirname $BASE1`
    echo "-- $BASE2/conf/httpd.conf -- "
    grep -i $1 $BASE2/conf/httpd.conf | grep -v \# 
    echo
    echo
  done
  cd $HERE
}

