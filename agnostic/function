function diffNoTime
{
    inputA=$1
    inputB=$2

	if [ x$inputB = x ] ; then
		echo "Usage: diffNoTime file1 file2"
		return
	fi

    here=$PWD
    temp
    cd $here
    RANDOMA=`getRandomNumber`
    RANDOMB=`expr $RANDOMA + 1`
    fileA=~/tmp/diff$RANDOMA
    fileB=~/tmp/diff$RANDOMB
    echo comparing $inputA and $inputB
    echo making $fileA and $fileB
    cat $inputA | perl -pe 's/2013-\d\d-\d\d/2013-MM-DD/g' | perl -pe 's/\d\d:\d\d:\d\d/hh:mm:ss/g' | perl -pe 's/mm:ss,\d\d\d/mm:ss,fff/' | perl -pe 's|13/\d\d/\d\d|13/MM/DD|g' > $fileA
    cat $inputB | perl -pe 's/2013-\d\d-\d\d/2013-MM-DD/g' | perl -pe 's/\d\d:\d\d:\d\d/hh:mm:ss/g' | perl -pe 's/mm:ss,\d\d\d/mm:ss,fff/' | perl -pe 's|13/\d\d/\d\d|13/MM/DD|g' > $fileB

    diff $fileA $fileB
    rm $fileA $fileB
}

