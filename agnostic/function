  if [ ! -d $BACKUPSDIR ]; then
    echo "WARING: no $BACKUPSDIR directory"
    echo "making $BACKUPSDIR directory"
    mkdir $BACKUPSDIR
  fi

  echo -n "copying $FILE to $BACKUPSDIR/$FILE\.$DATE...  "
  cp $FILE $BACKUPSDIR/$FILE\.$DATE  
  echo "done:"
  ls -l $BACKUPSDIR | tail -2

}

