function ecdiff ()
{
  FILE=$1
  CURRENT=`head -1 RCS/$1,v | cut -f2 -d\. | cut -f1 -d\;`
  PREVIOUS=$(( $CURRENT - 1 ))
  rcsdiff -r1.$PREVIOUS $1
}

function ecdiff2 ()
{
  FILE=$1
  HERE=`pwd`
  FILEDIR=`dirname $FILE`
  FILENAME=`basename $FILE`
  cd $FILEDIR
  CURRENT=`head -1 RCS/$FILENAME,v | cut -f2 -d\. | cut -f1 -d\;`
  PREVIOUS=$(( $CURRENT - 1 ))
  rcsdiff -r1.$PREVIOUS $FILENAME
  cd $HERE
}


