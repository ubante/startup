function audit-dbid
{
  partnernode=""
  incomingnode=""
  dbid=$1
  dbidline=`dbidtonode $dbid`
  thisnode=`echo $dbidline | cut -f2 -d\  `
  echo -- looking for dbid $dbid
  nodeline=`nodetodbid $thisnode`
  nodetodbid $thisnode
  incomingnode=`nodetodbid $thisnode | grep swap | cut -f2 -d\ `
  echo -- finding partner
  checkEven=`isEven $dbid`
  if [ $checkEven = "0" ]; then
        partnerdbid=`expr $dbid + 1`
        partnerline=`dbidtonode $partnerdbid`
        echo $partnerline
        partnernode=`echo $partnerline | cut -f2 -d\ `
  else
        partnerdbid=`expr $dbid - 1`
        partnerline=`dbidtonode $partnerdbid`
	echo $partnerline
	partnernode=`echo $partnerline | cut -f2 -d\ `
  fi 
  echo -- swap from scratch commands
  if [ -z $incomingnode ]; then
      echo "echo \";swap $thisnode -fromScratch too many swaps\" | nc lj3master 2200"
  else
      echo "This is incoming: || $incomingnode ||"
      echo "echo \";backup invalidate -id $dbid\" | nc $partnernode 2280"
      echo "echo \";shut\" | nc $incomingnode 2280"
      echo "echo \";shut\" | nc $partnernode 2280 "
  fi
  echo

  partnernode=""
  incomingnode=""

  echo -- checking swap reasons
  wget --quiet -O - http://lj3master.yst.yahoo.net:2201/alertsList.html?name=swappedOut | grep "dbid=$dbid)" | perl -ne 'm|>(20\d\d[\d-]*).*(\d\d:\d\d:\d\d).*(\(dbid=[\d]*[^<]*)| && print "$1 $2: $3\n"'

}

