function comparePasswdShadow
{
  local PASSWD=/etc/passwd
  local SHADOW=/etc/shadow
  local HERE=`pwd`
  local TEMPDIR=/tmp

  if [ $UID -ne 0 ]; then
    echo "You need to be root to run this function."
    return 0
  fi
  if [ ! x$1 == x ]; then
    PASSWD=$1
  fi
  if [ ! x$2 == x ]; then
    SHADOW=$2
  fi

  cut -f1 -d: $PASSWD | sort > $TEMPDIR/a
  cut -f1 -d: $SHADOW | sort > $TEMPDIR/b

  echo "unique to PASSWD:"
  for i in `diff $TEMPDIR/a $TEMPDIR/b | grep \< | cut -f2 -d\  `
  do 
    grep "^$i:" $PASSWD
  done
  echo
  echo "unique to SHADOW:"
  for i in `diff $TEMPDIR/a $TEMPDIR/b | grep \> | cut -f2 -d\  `
  do
    grep "^$i:" $SHADOW
  done
  echo

  cd $TEMPDIR
  rm a b
  cd $HERE
}

