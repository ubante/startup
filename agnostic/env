PATH=/usr/bin:/usr/sbin:/usr/local/bin:/usr/local/sbin:/bin:/sbin:$HOME/bin:$HOME/sbin
PS2="<-gimme more-> "
#export PI=`echo "scale=10; 4*a(1)" | bc -l`
export CVS_RSH='ssh'
export HISTFILESIZE=100000
export HISTSIZE=100000
export HISTTIMEFORMAT='%F %T '
unset HISTCONTROL  # this overrides the default of "ignorespace"
export LESS="-X -i -j7 -R" # for git
export EDITOR=vi
export PAGER="less -i"
export LS_COLORS='no=00:fi=00:di=01;34:ln=00;36:pi=40;33:so=00;35:bd=40;33;01:cd=40;33;01:or=01;05;37;41:mi=01;05;37;41:ex=00;32:*.cmd=00;32:*.exe=00;32:*.com=00;32:*.btm=00;32:*.bat=00;32:*.sh=00;32:*.csh=00;32:*.tar=00;31:*.tgz=00;31:*.arj=00;31:*.taz=00;31:*.lzh=00;31:*.zip=00;31:*.z=00;31:*.Z=00;31:*.gz=00;31:*.bz2=00;31:*.bz=00;31:*.tz=00;31:*.rpm=00;31:*.cpio=00;31:*.jpg=00;35:*.gif=00;35:*.bmp=00;35:*.xbm=00;35:*.xpm=00;35:*.png=00;35:*.tif=00;35:'
export SSH_ASKPASS=1
export SVN_EDITOR=vi
export Z="~/tmp/randomtempfile"

# No need to include your own name in the PS1
me=`whoami`
userbit=""
#if [ $me != john.ubante ]; then
if [ $me != j.ubante ]; then
	export userbit="$me-"
fi

export bhostname=`hostname | cut -f1 -d\.`

export PS1='\[\033[7;33m\]$(date +%H%M)\[\033[0m\]-\[\033[1;33m\]\[\033[0;31m\]$userbit\[\033[1;33m\]$bhostname\[\033[0m\]:\[\033[1;32m\]\W\$ \[\033[0m\]'

# colors
export RED='\033[0;31m'
export GREEN='\033[0;32m'
export YELLOW='\033[1;33m'
export BLUE='\033[0;34m'
export GRAY='\033[0;37m'
export NC='\033[0m' # No Color

# Ansible profile_tasks
export PROFILE_TASKS_SORT_ORDER=none
export PROFILE_TASKS_TASK_OUTPUT_LIMIT=200

# Useful for archiving local repos.  You can override this with host_specific files.
GRITYARD=~/src/grityard
